# PostgreSQL
POSTGRES_USER=aeuser
POSTGRES_PASSWORD=change_me
POSTGRES_DB=aetms_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MT5 ZeroMQ bridge host (where MQL5 REP socket listens)
MT5_HOST=mt5
MT5_PORT=5555

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# System
ENV=development
LOG_LEVEL=INFO

# Docker
PY_ENGINE_IMAGE=aetms_python_engine:latestMT5_LOGIN=your_login
MT5_PASSWORD=your_password
BINANCE_API_KEY=your_key
POSTGRES_USER=trading_admin
TELEGRAM_BOT_TOKEN=your_token
